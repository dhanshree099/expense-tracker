<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Expense Tracker</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f4f6fb;
            min-height: 100vh;
            color: #333;
        }

        /* Navbar */
        .navbar {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

        .navbar h1 {
            font-size: 24px;
        }

        .logout {
            text-decoration: none;
            color: white;
            padding: 9px 18px;
            border-radius: 8px;
            background: rgba(255,255,255,0.2);
            transition: 0.3s;
        }

        .logout:hover {
            background: white;
            color: #667eea;
        }

        /* Main container */
        .container {
            width: 90%;
            max-width: 1100px;
            margin: 40px auto;
        }

        /* Welcome */
        .welcome {
            margin-bottom: 30px;
        }

        .welcome h2 {
            font-size: 30px;
            margin-bottom: 5px;
        }

        .welcome p {
            color: #888;
        }

        /* Summary cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .card h3 {
            font-size: 14px;
            color: #888;
            margin-bottom: 8px;
        }

        .card p {
            font-size: 25px;
            font-weight: 600;
            color: #667eea;
        }

        /* Add expense */
        .expense-form {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 30px;
        }

        .expense-form h2 {
            margin-bottom: 20px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr auto;
            gap: 12px;
        }

        .form-row input {
            padding: 13px 15px;
            border: 2px solid #eee;
            border-radius: 9px;
            outline: none;
            font-family: 'Poppins', sans-serif;
        }

        .form-row input:focus {
            border-color: #667eea;
        }

        .add-btn {
            padding: 13px 22px;
            border: none;
            border-radius: 9px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .add-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 15px rgba(102,126,234,0.3);
        }

        /* Expenses */
        .expenses-section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .expenses-section h2 {
            margin-bottom: 20px;
        }

        .expense-list {
            list-style: none;
        }

        .expense-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px;
            border-bottom: 1px solid #eee;
        }

        .expense-item:last-child {
            border-bottom: none;
        }

        .expense-info {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .expense-title {
            font-weight: 600;
            font-size: 16px;
        }

        .category {
            width: fit-content;
            padding: 4px 10px;
            border-radius: 20px;
            background: #eef0ff;
            color: #667eea;
            font-size: 12px;
        }

        .expense-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .amount {
            color: #e74c3c;
            font-weight: 600;
        }

        .delete {
            text-decoration: none;
            color: white;
            background: #ff5c5c;
            padding: 7px 13px;
            border-radius: 7px;
            font-size: 12px;
            transition: 0.3s;
        }

        .delete:hover {
            background: #d93636;
        }

        .empty {
            text-align: center;
            padding: 25px;
            color: #999;
        }

        /* Mobile */
        @media (max-width: 800px) {

            .cards {
                grid-template-columns: 1fr;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .expense-item {
                align-items: flex-start;
                gap: 15px;
            }

            .expense-right {
                flex-direction: column;
                align-items: flex-end;
                gap: 8px;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">
        <h1>💰 Expense Tracker</h1>

        <a href="/logout" class="logout">
            Logout
        </a>
    </nav>


    <div class="container">

        <!-- Welcome -->
        <div class="welcome">
            <h2>Welcome, <%= user.name %> 👋</h2>
            <p>Track your expenses and manage your money easily.</p>
        </div>


        <!-- Summary Cards -->
        <div class="cards">

            <div class="card">
                <h3>💰 Total Expenses</h3>

                <p>
                    ₹<%= expenses.reduce((total, e) => total + Number(e.amount), 0) %>
                </p>
            </div>


            <div class="card">
                <h3>📊 Number of Expenses</h3>

                <p>
                    <%= expenses.length %>
                </p>
            </div>


            <div class="card">
                <h3>💳 Average Expense</h3>

                <p>
                    ₹<%= expenses.length
                        ? Math.round(
                            expenses.reduce(
                                (total, e) => total + Number(e.amount), 0
                            ) / expenses.length
                        )
                        : 0
                    %>
                </p>
            </div>

        </div>


        <!-- Add Expense -->
        <div class="expense-form">

            <h2>➕ Add New Expense</h2>

            <form method="POST" action="/expenses/add">

                <div class="form-row">

                    <input
                        name="title"
                        placeholder="Expense Title"
                        required
                    >

                    <input
                        name="amount"
                        type="number"
                        placeholder="Amount ₹"
                        required
                    >

                    <input
                        name="category"
                        placeholder="Category"
                        required
                    >

                    <button type="submit" class="add-btn">
                        Add Expense
                    </button>

                </div>

            </form>

        </div>


        <!-- Expense List -->
        <div class="expenses-section">

            <h2>📋 Your Expenses</h2>

            <% if (expenses.length === 0) { %>

                <div class="empty">
                    No expenses added yet. Start adding your expenses! 😊
                </div>

            <% } else { %>

                <ul class="expense-list">

                    <% expenses.forEach(e => { %>

                        <li class="expense-item">

                            <div class="expense-info">

                                <span class="expense-title">
                                    <%= e.title %>
                                </span>

                                <span class="category">
                                    <%= e.category %>
                                </span>

                            </div>


                            <div class="expense-right">

                                <span class="amount">
                                    ₹<%= e.amount %>
                                </span>

                                <a
                                    href="/expenses/delete/<%= e._id %>"
                                    class="delete"
                                    onclick="return confirm('Are you sure you want to delete this expense?')"
                                >
                                    Delete
                                </a>

                            </div>

                        </li>

                    <% }) %>

                </ul>

            <% } %>

        </div>

    </div>

</body>
</html>