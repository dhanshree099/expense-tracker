<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Expense - Expense Tracker</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;

            background: #f4f6fb;

            color: #333;

            min-height: 100vh;
        }


        /* ================= SIDEBAR SPACE ================= */

        .main {
            margin-left: 220px;

            min-height: 100vh;

            padding: 50px;
        }


        /* ================= PAGE HEADING ================= */

        .page-title {
            margin-bottom: 30px;
        }

        .page-title h1 {
            font-size: 30px;

            color: #333;

            margin-bottom: 5px;
        }

        .page-title p {
            color: #888;

            font-size: 14px;
        }


        /* ================= CARD ================= */

        .expense-card {
            background: white;

            max-width: 650px;

            padding: 35px;

            border-radius: 18px;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.08);
        }


        .expense-card h2 {
            color: #444;

            margin-bottom: 8px;

            font-size: 22px;
        }


        .expense-card .subtitle {
            color: #999;

            font-size: 13px;

            margin-bottom: 25px;
        }


        /* ================= FORM ================= */

        .form-group {
            margin-bottom: 20px;
        }


        .form-group label {
            display: block;

            margin-bottom: 8px;

            font-size: 14px;

            font-weight: 600;

            color: #555;
        }


        .form-group input {
            width: 100%;

            padding: 14px 16px;

            border: 2px solid #eeeeee;

            border-radius: 10px;

            outline: none;

            font-family: 'Poppins', sans-serif;

            font-size: 14px;

            transition: 0.3s;
        }


        .form-group input:focus {
            border-color: #667eea;

            box-shadow:
                0 0 10px rgba(102, 126, 234, 0.15);
        }


        /* ================= BUTTON ================= */

        .add-btn {
            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    #667eea,
                    #764ba2
                );

            color: white;

            font-family: 'Poppins', sans-serif;

            font-size: 15px;

            font-weight: 600;

            cursor: pointer;

            transition: 0.3s;
        }


        .add-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(102, 126, 234, 0.3);
        }


        /* ================= BACK BUTTON ================= */

        .back-btn {
            display: inline-block;

            margin-top: 20px;

            text-decoration: none;

            color: #667eea;

            font-size: 14px;

            font-weight: 500;

            transition: 0.3s;
        }


        .back-btn:hover {
            color: #764ba2;
        }


        /* ================= RESPONSIVE ================= */

        @media (max-width: 700px) {

            .main {
                margin-left: 0;

                padding: 25px;
            }


            .page-title h1 {
                font-size: 24px;
            }


            .expense-card {
                padding: 25px;
            }

        }

    </style>

</head>


<body>


    <!-- SIDEBAR -->

    <%- include("partials/sidebar") %>


    <!-- MAIN CONTENT -->

    <div class="main">


        <!-- PAGE TITLE -->

        <div class="page-title">

            <h1>
                💰 Add Expense
            </h1>

            <p>
                Record your spending and keep your finances organized.
            </p>

        </div>


        <!-- EXPENSE CARD -->

        <div class="expense-card">


            <h2>
                ➕ Add New Expense
            </h2>


            <p class="subtitle">
                Enter the details of your expense below.
            </p>


            <form
                action="/add-expense"
                method="POST"
            >


                <!-- EXPENSE NAME -->

                <div class="form-group">

                    <label for="name">
                        Expense Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Example: Shopping"
                        required
                    >

                </div>


                <!-- AMOUNT -->

                <div class="form-group">

                    <label for="amount">
                        Amount
                    </label>

                    <input
                        type="number"
                        id="amount"
                        name="amount"
                        placeholder="Enter amount ₹"
                        min="1"
                        required
                    >

                </div>


                <!-- BUTTON -->

                <button
                    type="submit"
                    class="add-btn"
                >
                    ➕ Add Expense
                </button>


            </form>


            <a
                href="/dashboard"
                class="back-btn"
            >
                ← Back to Dashboard
            </a>


        </div>


    </div>


</body>

</html>