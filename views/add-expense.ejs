<body>

    <%- include("partials/sidebar") %>

        <div class="main">

            <div class="page-header">
                <div>
                    <h1>Add Expense</h1>
                    <p>Track your spending and manage finances efficiently.</p>
                </div>

                <div class="header-badge">
                    💰 Expense Manager
                </div>
            </div>

            <div class="content-grid">

                <div class="expense-form-card">

                    <h2>New Expense</h2>

                    <form action="/add-expense" method="POST">

                        <div class="input-box">
                            <label>Expense Name</label>
                            <div class="input-wrapper">
                                <span>📝</span>
                                <input type="text" name="name" placeholder="Shopping, Food, Fuel..." required>
                            </div>
                        </div>

                        <div class="input-box">
                            <label>Amount</label>
                            <div class="input-wrapper">
                                <span>₹</span>
                                <input type="number" name="amount" placeholder="Enter Amount" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="category">
                                🏷️ Category
                            </label>

                            <select id="category" name="category" required>
                                <option value="">Select Category</option>
                                <option value="Food">🍔 Food</option>
                                <option value="Travel">🚗 Travel</option>
                                <option value="Shopping">🛍️ Shopping</option>
                                <option value="Bills">💡 Bills</option>
                                <option value="Health">🏥 Health</option>
                                <option value="Education">📚 Education</option>
                                <option value="Entertainment">🎬 Entertainment</option>
                                <option value="Other">📦 Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="date">
                                Expense Date
                            </label>

                            <input type="date" id="date" value="<%= new Date().toISOString().split('T')[0] %>"
                                name="date" required>
                        </div>

                        <button class="submit-btn">
                            Add Expense
                        </button>

                    </form>

                </div>

                <div class="info-card">

                    <h3>Financial Tips</h3>

                    <div class="tip">
                        💡 Track every expense daily.
                    </div>

                    <div class="tip">
                        📈 Review reports weekly.
                    </div>

                    <div class="tip">
                        🎯 Set monthly spending goals.
                    </div>

                </div>

            </div>

        </div>

</body>
<style>
    .form-group select {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid #eeeeee;
        border-radius: 12px;
        outline: none;
        font-size: 14px;
        font-family: 'Poppins', sans-serif;
        background: #fff;
        cursor: pointer;
        transition: .3s;
    }

    .form-group select:focus {
        border-color: #667eea;
        box-shadow: 0 0 10px rgba(102, 126, 234, .15);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #555;
    }

    .form-group input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid #eeeeee;
        border-radius: 12px;
        outline: none;
        font-size: 14px;
        font-family: 'Poppins', sans-serif;
        transition: all .3s ease;
        background: #fff;
    }

    .form-group input:focus {
        border-color: #667eea;
        box-shadow: 0 0 12px rgba(102, 126, 234, .15);
    }

    .form-group input[type="date"] {
        cursor: pointer;
        color: #444;
        font-weight: 500;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: #f8fafc;
    }

    .main {
        margin-left: 260px;
        padding: 40px;
    }

    .page-header {
        display: flex;
