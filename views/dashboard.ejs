<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Expense Tracker - Dashboard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f4f6fb;
            color: #333;
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .navbar h1 {
            font-size: 24px;
            font-weight: 600;
        }

        .logout {
            color: white;
            text-decoration: none;
            padding: 9px 18px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.2);
        }

        .logout:hover {
            background: white;
            color: #667eea;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 40px auto;
        }

        .heading {
            margin-bottom: 30px;
        }

        .heading h2 {
            font-size: 30px;
            color: #333;
        }

        .heading p {
            color: #888;
            margin-top: 5px;
        }

        .expense-form {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            margin-bottom: 35px;
        }

        .expense-form h2 {
            margin-bottom: 20px;
            color: #444;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 15px;
        }

        .form-row input {
            padding: 14px;
            border: 2px solid #eee;
            border-radius: 9px;
            outline: none;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }

        .form-row input:focus {
            border-color: #667eea;
        }

        .add-btn {
            border: none;
            padding: 14px 25px;
            border-radius: 9px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

        .chart-container {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            margin-bottom: 35px;
        }

        .chart-container h2 {
            margin-bottom: 25px;
            color: #444;
        }

        .chart-box {
            width: 100%;
            height: 400px;
        }

        .table-container {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            overflow-x: auto;
        }

        .table-container h2 {
            margin-bottom: 20px;
            color: #444;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        thead {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        th {
            padding: 15px;
            text-align: left;
            font-size: 14px;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            vertical-align: middle;
        }

        tbody tr:hover {
            background: #f7f7ff;
        }

        .amount {
            color: #e74c3c;
            font-weight: 600;
            white-space: nowrap;
        }

        .date {
            color: #667eea;
            font-weight: 500;
            min-width: 350px;
        }

        .time {
            color: #888;
            font-weight: 500;
            white-space: nowrap;
        }

        .action-buttons {
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .action-buttons form {
            margin: 0;
            padding: 0;
        }

        .edit-btn {
            background: #3498db;
            color: white;
            text-decoration: none;
            padding: 10px 16px;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }

        .edit-btn:hover {
            background: #2980b9;
        }

        .delete-btn {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 7px;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            white-space: nowrap;
        }

        .delete-btn:hover {
            background: #c0392b;
        }

        .empty {
            text-align: center;
            padding: 30px;
            color: #999;
        }

        @media (max-width: 700px) {

            .form-row {
                grid-template-columns: 1fr;
            }

            .navbar h1 {
                font-size: 19px;
            }

            .heading h2 {
                font-size: 24px;
            }

            .chart-container {
                padding: 20px;
            }

            .chart-box {
                height: 300px;
            }

            th,
            td {
                padding: 10px;
            }

        }

    </style>

</head>

<body>
   
    <%- include('partials/sidebar') %>

    <nav class="navbar">

        <h1>
            💰 Expense Tracker
        </h1>

        <a href="/logout" class="logout">
            Logout
        </a>

    </nav>

    <div class="container">

        <div class="heading">

            <h2>
                📊 Expense Dashboard
            </h2>

            <p>
                Keep track of your spending and manage your expenses easily.
            </p>

        </div>

        <div class="expense-form">

            <h2>
                ➕ Add New Expense
            </h2>

            <form action="/add-expense" method="POST">

                <div class="form-row">

                    <input
                        type="text"
                        name="name"
                        placeholder="Expense Name"
                        required
                    >

                    <input
                        type="number"
                        name="amount"
                        placeholder="Amount ₹"
                        required
                    >

                    <button
                        type="submit"
                        class="add-btn"
                    >
                        Add Expense
                    </button>

                </div>

            </form>

        </div>

        <div class="chart-container">

            <h2>
                📈 Expense Chart
            </h2>

            <div class="chart-box">

                <canvas id="expenseChart"></canvas>

            </div>

        </div>

        <div class="table-container">

            <h2>
                📋 All Expenses
            </h2>

            <% if (expenses.length === 0) { %>

                <div class="empty">

                    <p>
                        💸 No expenses added yet.
                    </p>

                    <p>
                        Start by adding your first expense above!
                    </p>

                </div>

            <% } else { %>

                <table>

                    <thead>

                        <tr>

                            <th>Expense Name</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% expenses.forEach(exp => { %>

                            <tr>

                                <td>
                                    <strong>
                                        <%= exp.name %>
                                    </strong>
                                </td>

                                <td class="amount">
                                    ₹<%= exp.amount %>
                                </td>

                                <td class="date">

                                    <%
                                        let formattedDate;

                                        if (exp.date instanceof Date) {

                                            formattedDate = exp.date.toString();

                                        } else {

                                            let tempDate = new Date(exp.date);

                                            if (!isNaN(tempDate.getTime())) {

                                                formattedDate = tempDate.toString();

                                            } else {

                                                formattedDate = exp.date;

                                            }
                                        }
                                    %>

                                    <%= formattedDate %>

                                </td>

                                <td class="time">
                                    <%= exp.time %>
                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a
                                            href="/edit-expense/<%= exp._id %>"
                                            class="edit-btn"
                                        >
                                            ✏️ Edit
                                        </a>

                                        <form
                                            action="/delete-expense/<%= exp._id %>"
                                            method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this expense?')"
                                        >

                                            <button
                                                type="submit"
                                                class="delete-btn"
                                            >
                                                🗑️ Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>

    </div>

    <script>

        const expenseNames =
            <%- JSON.stringify(expenses.map(exp => exp.name)) %>;

        const expenseAmounts =
            <%- JSON.stringify(expenses.map(exp => exp.amount)) %>;

        const ctx =
            document.getElementById("expenseChart");

        new Chart(ctx, {

            type: "bar",

            data: {

                labels: expenseNames,

                datasets: [

                    {
                        label: "Expense Amount ₹",
                        data: expenseAmounts,
                        borderWidth: 1
                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                scales: {

                    y: {

                        beginAtZero: true,

                        title: {

                            display: true,

                            text: "Amount ₹"

                        }

                    },

                    x: {

                        title: {

                            display: true,

                            text: "Expense Name"

                        }

                    }

                }

            }

        });

    </script>

</body>
</html>
