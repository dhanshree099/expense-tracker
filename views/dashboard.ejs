<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Expense Tracker - Dashboard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f4f6fb;
            color: #333;
            min-height: 100vh;
        }


        /* ================= NAVBAR ================= */

        .navbar {
            background: linear-gradient(135deg, #667eea, #764ba2);

            color: white;

            padding: 18px 7%;

            display: flex;

            justify-content: space-between;

            align-items: center;

            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .navbar h1 {
            font-size: 24px;
            font-weight: 600;
        }

        .logout {
            color: white;

            text-decoration: none;

            padding: 9px 18px;

            border-radius: 8px;

            background: rgba(255, 255, 255, 0.2);

            transition: 0.3s;
        }

        .logout:hover {
            background: white;
            color: #667eea;
        }


        /* ================= MAIN CONTAINER ================= */

        .container {
            width: 90%;

            max-width: 1100px;

            margin: 40px auto;
        }


        /* ================= HEADING ================= */

        .heading {
            margin-bottom: 30px;
        }

        .heading h2 {
            font-size: 30px;
            color: #333;
        }

        .heading p {
            color: #888;
            margin-top: 5px;
        }


        /* ================= ADD EXPENSE ================= */

        .expense-form {
            background: white;

            padding: 30px;

            border-radius: 15px;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);

            margin-bottom: 35px;
        }

        .expense-form h2 {
            margin-bottom: 20px;
            color: #444;
        }

        .form-row {
            display: grid;

            grid-template-columns: 1fr 1fr auto;

            gap: 15px;
        }

        .form-row input {
            padding: 14px;

            border: 2px solid #eee;

            border-radius: 9px;

            outline: none;

            font-family: 'Poppins', sans-serif;

            font-size: 14px;

            transition: 0.3s;
        }

        .form-row input:focus {
            border-color: #667eea;

            box-shadow: 0 0 8px rgba(102, 126, 234, 0.15);
        }

        .add-btn {
            border: none;

            padding: 14px 25px;

            border-radius: 9px;

            background: linear-gradient(135deg, #667eea, #764ba2);

            color: white;

            font-family: 'Poppins', sans-serif;

            font-size: 14px;

            font-weight: 600;

            cursor: pointer;

            transition: 0.3s;
        }

        .add-btn:hover {
            transform: translateY(-2px);

            box-shadow: 0 8px 18px rgba(102, 126, 234, 0.3);
        }


        /* ================= TABLE ================= */

        .table-container {
            background: white;

            padding: 30px;

            border-radius: 15px;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);

            overflow-x: auto;
        }

        .table-container h2 {
            margin-bottom: 20px;

            color: #444;
        }

        table {
            width: 100%;

            border-collapse: collapse;
        }

        thead {
            background: linear-gradient(135deg, #667eea, #764ba2);

            color: white;
        }

        th {
            padding: 15px;

            text-align: left;

            font-size: 14px;

            font-weight: 600;
        }

        td {
            padding: 15px;

            border-bottom: 1px solid #eee;

            font-size: 14px;

            vertical-align: middle;
        }

        tbody tr {
            transition: 0.2s;
        }

        tbody tr:hover {
            background: #f7f7ff;
        }


        /* ================= AMOUNT ================= */

        .amount {
            color: #e74c3c;

            font-weight: 600;

            white-space: nowrap;
        }


        /* ================= DATE ================= */

        .date {
            color: #667eea;

            font-weight: 500;

            min-width: 350px;
        }


        /* ================= TIME ================= */

        .time {
            color: #888;

            font-weight: 500;

            white-space: nowrap;
        }


        /* ================= EMPTY ================= */

        .empty {
            text-align: center;

            padding: 30px;

            color: #999;
        }


        /* ================= RESPONSIVE ================= */

        @media (max-width: 700px) {

            .form-row {
                grid-template-columns: 1fr;
            }

            .navbar h1 {
                font-size: 19px;
            }

            .heading h2 {
                font-size: 24px;
            }

            th,
            td {
                padding: 10px;
            }

        }

    </style>

</head>


<body>


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <h1>
            💰 Expense Tracker
        </h1>

        <a
            href="/logout"
            class="logout"
        >
            Logout
        </a>

    </nav>


    <!-- ================= MAIN CONTENT ================= -->

    <div class="container">


        <!-- ================= HEADING ================= -->

        <div class="heading">

            <h2>
                📊 Expense Dashboard
            </h2>

            <p>
                Keep track of your spending and manage your expenses easily.
            </p>

        </div>


        <!-- ================= ADD EXPENSE ================= -->

        <div class="expense-form">

            <h2>
                ➕ Add New Expense
            </h2>

            <form
                action="/add-expense"
                method="POST"
            >

                <div class="form-row">

                    <input
                        type="text"
                        name="name"
                        placeholder="Expense Name"
                        required
                    >

                    <input
                        type="number"
                        name="amount"
                        placeholder="Amount ₹"
                        required
                    >

                    <button
                        type="submit"
                        class="add-btn"
                    >
                        Add Expense
                    </button>

                </div>

            </form>

        </div>


        <!-- ================= EXPENSE TABLE ================= -->

        <div class="table-container">

            <h2>
                📋 All Expenses
            </h2>


            <% if (expenses.length === 0) { %>

                <div class="empty">

                    <p>
                        💸 No expenses added yet.
                    </p>

                    <p>
                        Start by adding your first expense above!
                    </p>

                </div>


            <% } else { %>


                <table>

                    <thead>

                        <tr>

                            <th>
                                Expense Name
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Time
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        <% expenses.forEach(exp => { %>


                            <tr>


                                <!-- EXPENSE NAME -->

                                <td>

                                    <strong>
                                        <%= exp.name %>
                                    </strong>

                                </td>


                                <!-- AMOUNT -->

                                <td class="amount">

                                    ₹<%= exp.amount %>

                                </td>


                                <!-- DATE -->

                                <td class="date">

                                    <%
                                        let formattedDate;

                                        if (exp.date instanceof Date) {

                                            formattedDate = exp.date.toString();

                                        } else {

                                            let tempDate = new Date(exp.date);

                                            if (!isNaN(tempDate.getTime())) {

                                                formattedDate = tempDate.toString();

                                            } else {

                                                formattedDate = exp.date;

                                            }
                                        }
                                    %>

                                    <%= formattedDate %>

                                </td>


                                <!-- TIME -->

                                <td class="time">

                                    <%= exp.time %>

                                </td>


                            </tr>


                        <% }) %>


                    </tbody>

                </table>


            <% } %>


        </div>


    </div>


</body>

</html>